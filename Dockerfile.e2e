# pulse-api's e2e tests as an image, built and pushed next to the app image
# with the same sha-<short> tag (.github/workflows/pipeline.yml). Kargo's
# verification (gitops-poc kargo/pulse-api/e2e.yaml) runs the one from the
# same commit as the app it's verifying.
#
# Contract: takes the base URL as its only argument, exits 0 when every
# check passes. Swapping the tests for Playwright or `dotnet test` means a
# different base image and ENTRYPOINT here - nothing changes in Kargo.
#
#   docker build -f Dockerfile.e2e -t pulse-api-e2e .
#   docker run --rm --network gitops-poc_k8s-management pulse-api-e2e http://k3s-stg:30081
FROM alpine:3.22

RUN apk add --no-cache bash curl

COPY scripts/e2e.sh /e2e.sh

USER 65534:65534
ENTRYPOINT ["/e2e.sh"]
